{
  "name": "@cto.af/unicode-trie-root",
  "version": "3.2.9",
  "description": "Quick fork of unicode-trie for modernity",
  "type": "module",
  "private": "true",
  "workspaces": [
    "pkg/*"
  ],
  "scripts": {
    "clean": "rm -rf coverage examples/LineBreak.js && pnpm run -r clean",
    "docs": "pnpm run -r docs",
    "test": "c8 pnpm run -r test",
    "lint": "eslint .",
    "types": "pnpm run -r types",
    "examples": "node examples/genLineBreak.js",
    "build": "npm run types && npm run lint && npm run test && npm run docs",
    "version": "monopub version && pnpm run --sequential --if-present -r version && pnpm i -r && git add pnpm-lock.yaml"
  },
  "keywords": [
    "unicode",
    "properties",
    "icu",
    "trie",
    "compressed",
    "brotli"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "contributors": [
    "Joe Hildebrand <joe-github@cursive.net>",
    "valadaptive <valadaptive@protonmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cto-af/unicode-trie.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@cto.af/eslint-config": "7.0.3",
    "@cto.af/monopub": "2.0.2",
    "@cto.af/unicode-trie": "link:pkg/unicode-trie",
    "@cto.af/unicode-trie-runtime": "link:pkg/unicode-trie-runtime",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-mocha": "12.0.2",
    "mocha": "12.0.3",
    "superc8": "^12.7.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
