{
  "name": "@cto.af/unicode-trie-runtime",
  "version": "3.2.10",
  "description": "Runtime code for unicode-trie files.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js",
      "types": "./types/index.d.ts"
    },
    "./constants.js": {
      "default": "./constants.js",
      "types": "./types/constants.js"
    },
    "./swap.js": {
      "default": "./swap.js",
      "types": "./types/swap.js"
    }
  },
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf coverage docs types",
    "docs": "typedoc",
    "test": "mocha",
    "types": "tsc",
    "build": "npm run lint && npm run types && npm run test"
  },
  "keywords": [
    "unicode",
    "properties",
    "icu",
    "trie",
    "compressed",
    "brotli"
  ],
  "author": "Devon Govett <devongovett@gmail.com>",
  "contributors": [
    "Joe Hildebrand <joe-github@cursive.net>",
    "valadaptive <valadaptive@protonmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cto-af/unicode-trie.git"
  },
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "mocha": "^12.0.3",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=22"
  }
}
